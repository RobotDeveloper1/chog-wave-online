# ── Privy (sign-in) ──────────────────────────────────────────────────────────────
# Create an app at https://dashboard.privy.io
# Login methods: wallet only (the game opens Privy's wallet modal)
# Add Monad Testnet as a chain (id 10143, https://testnet-rpc.monad.xyz)
# Allow the game origin (http://localhost:5173 for local dev)
# Copy the App ID and App Secret from the dashboard.

# Client — baked into the Vite bundle
VITE_PRIVY_APP_ID=

# Server — verifies Privy tokens and reads the wallet off the user object.
# The secret never leaves the server; if it leaks, regenerate it in the dashboard.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Chain: the testnet replica ───────────────────────────────────────────────────
# Written by contracts/scripts/deploy.mjs. The game reads holdings from here.
MONAD_RPC=https://testnet-rpc.monad.xyz
CHOG_GENESIS_CONTRACT=

# ── Deploy (testnet only, never mainnet keys) ─────────────────────────────────────
# A throwaway key funded at https://faucet.monad.xyz, plus the wallet to mint to
# (paste your connected wallet address after the first login).
DEPLOYER_KEY=
MINT_TO=
MINT_COUNT=3
